# All data sources are free and need no key. NEVER commit a real key.
# Optional, and only used for the PumpPortal websocket:
# PUMPPORTAL_API_KEY=replace_me

# Optional local dashboard port. Default: 3000.
# WEB_PORT=3000

# ---- Money limits (bot 3). These are the only settings the dashboard asks for. ----
# PAPER_START_BALANCE_SOL=1
# BUY_AMOUNT_SOL=0.01
# MAX_OPEN_POSITIONS=3
# MAX_ENTRIES_PER_DAY=20
# MAX_DAILY_LOSS_SOL=0.05
# How realistic the simulated fills are, PER SIDE. These two decide more about the measured PnL
# than any strategy choice: 100 + 200 bps means a round trip costs 6% of the price before the
# trade has done anything, which is far above a real Solana AMM swap at 0.01 SOL. It also forces
# every stop wider (no stop may sit inside the round-trip cost), pushing the bot towards only the
# wildest coins. Something like 30 / 100 is closer to reality; lower them and the whole strategy
# tightens with them.
# PAPER_FEE_BPS=100
# PAPER_SLIPPAGE_BPS=200

# There are NO entry/exit settings, and no take-profit target. Bot 3 measures how much each coin
# moves per minute and derives its own dip, bounce, flat stop, trailing stop and patience from that
# (src/signals.js, deriveLevels). A winning trade is ended by the trailing stop, never by a target
# or a timer; once it has been far enough up, its flat floor ratchets to break-even.

# ---- Bot 1: how wide and how fast it screens (see PIPELINE.md) ----
# Round-robin over 17 pages of new / trending / top-volume pools. The budget below paces the calls
# evenly; this tick only asks whether one may go out, so ticking faster than the budget costs nothing.
# DISCOVERY_TICK_MS=1000
# A GeckoTerminal call can take several seconds, so a few may be in the air at once.
# MAX_SWEEPS_IN_FLIGHT=3
# The CEILING for GeckoTerminal calls, not a promise. It documents 30/min but gives an individual
# IP less, and answers a BURST with 429 even when the average is legal. So calls go out evenly
# spaced, the feed halves its rate whenever it is refused, and it creeps back up but never past a
# rate that was already refused. What it settles on is remembered in data/feed-state.json, so a
# restart does not rediscover it (4-7 a minute is typical).
# GECKO_CALLS_PER_MINUTE=15
# It never slows below this.
# GECKO_MIN_CALLS_PER_MINUTE=4
# DexScreener re-check: EVERY coin bot 1 has met, on a rotation, closest-to-a-decision first. This
# is what catches an old coin waking up. 3 calls x 30 coins every 2s = ~2,700 coins/min; a probe
# measured DexScreener answering ~4,000 coins/min without complaint, so there is headroom.
# REFRESH_INTERVAL_MS=2000
# REFRESH_BATCH_SIZE=30
# REFRESH_CALLS_PER_TICK=3
# How many coins stay in memory. The ones seen longest ago are dropped first; green and held coins
# are never dropped.
# MAX_UNIVERSE_TOKENS=20000

# ---- Bot 2: how often a coin is re-judged, and where green starts ----
# A coin is re-judged at most this often, however many times bot 1 sees it in between.
# RESCORE_INTERVAL_MS=15000
# Pump score (0-1) at which a coin is handed to bot 3, and the score at which it is kept and watched.
# GREEN_SCORE=0.58
# WATCH_SCORE=0.4
# MAX_GREEN_COINS=60

# ---- Bot 2: safety floors (not strategy) ----
# A coin that fails one of these cannot be paper-traded honestly, so no score can rescue it.
# MIN_LIQUIDITY_USD=5000
# Liquidity as a fraction of market cap: a $5M coin behind a $20k pool is a trap.
# MIN_LIQUIDITY_RATIO=0.015
# Below these in the last hour the coin is dead, not quiet.
# MIN_TRADES_H1=15
# MIN_VOLUME_H1_USD=2000
# MIN_MARKET_CAP_USD=20000
# MAX_MARKET_CAP_USD=30000000
# Dev history, learned from launches this bot saw while running. 0 disables a rule.
# MAX_DEV_RUGS=1
# MAX_DEV_LAUNCHES=5
# A coin that falls this fraction from its observed peak counts as a rug against its creator (0.8 = -80%).
# RUG_DROP_PCT=0.8

# Holder-concentration gate. Only active when SOLANA_RPC_URL is set. It may contain a provider key,
# so keep it only in .env. The public mainnet endpoint rate-limits these calls heavily.
# SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=0a6863b7-36ac-40a4-ab15-d42e34283b2a
# MAX_TOP_HOLDERS_PCT=35
# TOP_HOLDERS_COUNT=5
# Skip the single largest account when summing (usually the AMM pool vault). Heuristic.
# TOP_HOLDERS_SKIP_LARGEST=true

# ---- Bot 3: which entries it may take ----
# dip      = only buy a pullback that bounces. Best fill, but a coin that climbs steadily never
#            dips, so the whole move goes past.
# breakout = only buy new highs. Catches the climbers, pays a worse price.
# both     = whichever comes first (default). Every entry records which trigger fired, and
#            npm run report shows which one is actually making the money.
# ENTRY_MODE=both

# ---- Bot 3: how closely it watches what it might buy ----
# WATCH_POLL_INTERVAL_MS=3000
# MAX_WATCHLIST=40
# A green coin that never triggers an entry goes back to bot 2's list after this long.
# GREEN_GRACE_MS=600000
