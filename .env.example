# Optional. The free mode (default) works without a key. NEVER commit a real key.
# PUMPPORTAL_API_KEY=replace_me

# free = PumpPortal launches/migrations + DexScreener/GeckoTerminal prices (no SOL needed)
# pumpportal = paid PumpPortal trade stream (needs wallet with >= 0.02 SOL)
# TRADE_SOURCE=free
# POLL_INTERVAL_MS=3000

# SOCIAL_MODE: twitter = X/Twitter required (default) | any = at least one link | multiple = at least two link types | off = no social filter
# SOCIAL_MODE=twitter

# Market-cap screening bounds are in USD.
# MIN_MARKET_CAP_USD=40000
# MAX_MARKET_CAP_USD=160000

# Optional local dashboard port. Default: 3000.
# WEB_PORT=3000
