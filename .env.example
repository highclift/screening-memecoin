# Optional. The free mode (default) works without a key. NEVER commit a real key.
# PUMPPORTAL_API_KEY=replace_me

# free = PumpPortal launches/migrations + DexScreener/GeckoTerminal prices (no SOL needed)
# pumpportal = paid PumpPortal trade stream (needs wallet with >= 0.02 SOL)
# TRADE_SOURCE=free
# POLL_INTERVAL_MS=3000

# SOCIAL_MODE: twitter = X/Twitter required (default) | any = at least one link | multiple = at least two link types | off = no social filter
# SOCIAL_MODE=twitter

# Market-cap screening bounds are in USD.
# MIN_MARKET_CAP_USD=40000
# MAX_MARKET_CAP_USD=160000

# Optional local dashboard port. Default: 3000.
# WEB_PORT=3000

# ---- Filter + analyst pipeline (see PIPELINE.md). All optional; these are starting points to tune. ----
# Analyst score (0-1) a candidate needs before a paper entry.
# MIN_SCORE=0.5
# Reject pools with less liquidity than this (only when the data source reports liquidity).
# MIN_LIQUIDITY_USD=5000
# Dev history, learned from launches this bot saw while running. 0 disables a rule.
# MAX_DEV_RUGS=1
# MAX_DEV_LAUNCHES=5
# A token that falls this fraction from its observed peak while screened counts as a rug (0.8 = -80%).
# RUG_DROP_PCT=0.8

# Holder-concentration check. Only active when SOLANA_RPC_URL is set. It may contain a provider
# key, so keep it only in .env. The public mainnet endpoint rate-limits these calls heavily.
# SOLANA_RPC_URL=
# MAX_TOP_HOLDERS_PCT=35
# TOP_HOLDERS_COUNT=5
# Skip the single largest account when summing (usually the AMM pool vault). Heuristic.
# TOP_HOLDERS_SKIP_LARGEST=true

# Token metadata is only fetched from these hosts (comma-separated; replaces the default list of
# common IPFS/Arweave gateways). Anything else is skipped so a token creator cannot make this
# machine request arbitrary URLs.
# METADATA_HOSTS=ipfs.io,cf-ipfs.com,gateway.pinata.cloud
