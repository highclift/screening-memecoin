# All data sources are free and need no key. NEVER commit a real key.
# Optional, and only used for the PumpPortal websocket:
# PUMPPORTAL_API_KEY=replace_me

# Optional local dashboard port. Default: 3000.
# WEB_PORT=3000

# ---- The window the desk trades (agent 1, the scout) ----
# Under 30 minutes a coin has no history to measure and its first candle is bots trading with bots.
# Past 72 hours the launch crowd has gone and what is left is a chart, not an event. Coins outside
# the window are still watched — they can walk into it — but they are not handed to the filter.
# MIN_AGE_MINUTES=30
# MAX_AGE_HOURS=72
# MIN_MARKET_CAP_USD=300000
# MAX_MARKET_CAP_USD=20000000

# ---- Money limits (agent 5, risk). These are the only settings the dashboard asks for. ----
# PAPER_START_BALANCE_SOL=1
# Share of the paper balance per trade, not a fixed amount: the desk scales itself down after a bad
# night instead of betting the same size into a smaller account. 0.08 = 8%.
# POSITION_PCT=0.08
# MIN_POSITION_SOL=0.002
# MAX_OPEN_POSITIONS=3
# MAX_ENTRIES_PER_DAY=20
# MAX_DAILY_LOSS_SOL=0.05

# ---- The shape of a trade (agent 5, risk) ----
# The flat stop, fixed BEFORE the entry is taken and never widened. It cannot save you from a rug:
# those go from above the stop to near zero between two polls, with no price in between to sell at.
# STOP_PCT=0.06
# Nothing trails until the position has been this far up. From that point the floor is the better of
# break-even and TRAIL_PCT under the peak, and it only ever moves up — so a trade that got far
# enough into profit cannot come back as a loss. TRAIL_AFTER_PCT must be greater than STOP_PCT, or
# the stop could never fire first and the bot refuses to start.
# TRAIL_AFTER_PCT=0.12
# TRAIL_PCT=0.08
# A position not covering its costs and no longer making new highs is not working.
# STALL_MINUTES=4
# How long a position may be held at all, from entry. These coins pump fast and die fast:
# replaying the measured session against real prices, a ten-minute cap turned -1.05 SOL into
# -0.53 SOL, because the long holds were where the rugs landed and the winners had already made
# their money. It costs a little upside on a genuine runner, deliberately.
# MAX_HOLD_MINUTES=10
# How realistic the simulated fills are, PER SIDE. These two decide more about the measured PnL
# than any strategy choice: 100 + 200 bps means a round trip costs 6% of the price before the
# trade has done anything, which is far above a real Solana AMM swap at 0.01 SOL. It also forces
# every stop wider (no stop may sit inside the round-trip cost), pushing the bot towards only the
# wildest coins. Something like 30 / 100 is closer to reality; lower them and the whole strategy
# tightens with them.
# PAPER_FEE_BPS=30
# PAPER_SLIPPAGE_BPS=70

# There is no take-profit target, deliberately: a target caps a winner at exactly the moment it is
# working, so the trail is what ends a winning trade. The ENTRY timing is still measured from the
# coin itself — the executor watches each candidate until it knows how much that coin moves in a
# minute, and sizes its dip and bounce from that (src/signals.js, volatilityPct).

# ---- Agent 2: the hard kills ----
# How much of the DEEPEST pool's LP must be burned or locked. Below this somebody can still pull the
# liquidity you were planning to sell into — which is what a rug actually is: not a price falling,
# a pool ceasing to exist. Read from RugCheck, which is free and needs no key.
# MIN_LP_LOCKED_PCT=90
# What the creator may still hold, and how much supply may sit in wallets that have passed the token
# between themselves (RugCheck's insider networks — the clusters a bubble map draws).
# MAX_DEV_PCT=3
# MAX_BUNDLED_PCT=10
# A coin already up this much in an hour has had its move; what is left is the giving-back.
# MAX_PRICE_CHANGE_H1=80
# RugCheck allows 15 calls a minute. One below that, evenly paced, and only ever spent on a coin
# that has already survived every cheaper check.
# RUGCHECK_CALLS_PER_MINUTE=12

# ---- Agent 3: the analyst ----
# Out of 100, from momentum, unique buyers, buy/sell ratio, holder growth, liquidity against market
# cap, and smart wallets (src/signals.js, deskScore). Only this and above reaches the executor.
# An unmeasured coin scores 50, so it is never bought on a shrug.
# PASS_SCORE=70

# ---- Agent 1: how wide and how fast it looks (see PIPELINE.md) ----
# Round-robin over 17 pages of new / trending / top-volume pools. The budget below paces the calls
# evenly; this tick only asks whether one may go out, so ticking faster than the budget costs nothing.
# DISCOVERY_TICK_MS=1000
# A GeckoTerminal call can take several seconds, so a few may be in the air at once.
# MAX_SWEEPS_IN_FLIGHT=3
# The CEILING for GeckoTerminal calls, not a promise. It documents 30/min but gives an individual
# IP less, and answers a BURST with 429 even when the average is legal. So calls go out evenly
# spaced, the feed halves its rate whenever it is refused, and it creeps back up but never past a
# rate that was already refused. What it settles on is remembered in data/feed-state.json, so a
# restart does not rediscover it (4-7 a minute is typical).
# GECKO_CALLS_PER_MINUTE=15
# It never slows below this.
# GECKO_MIN_CALLS_PER_MINUTE=4
# DexScreener re-check: EVERY coin the scout has met, on a rotation, closest-to-a-decision first. This
# is what catches an old coin waking up. 3 calls x 30 coins every 2s = ~2,700 coins/min; a probe
# measured DexScreener answering ~4,000 coins/min without complaint, so there is headroom.
# REFRESH_INTERVAL_MS=2000
# REFRESH_BATCH_SIZE=30
# REFRESH_CALLS_PER_TICK=3
# How many coins stay in memory. The ones seen longest ago are dropped first; coins through the
# filter and coins being held are never dropped.
# MAX_UNIVERSE_TOKENS=20000

# ---- How often a coin is re-judged ----
# Every coin the scout keeps seeing is put through the filter and the analyst again this often, so
# a coin that fails a check now is free to pass it in fifteen seconds, and vice versa.
# RESCORE_INTERVAL_MS=15000

# ---- Agent 2: safety floors (not strategy) ----
# A coin that fails one of these cannot be paper-traded honestly, so no score can rescue it.
# MIN_LIQUIDITY_USD=25000
# Liquidity as a fraction of market cap: a $5M coin behind a $20k pool is a trap.
# MIN_LIQUIDITY_RATIO=0.015
# Below these in the last hour the coin is dead, not quiet.
# MIN_TRADES_H1=15
# MIN_VOLUME_H1_USD=2000
# How many DIFFERENT wallets must have bought in the last hour, and how many trades each of them
# may account for. Volume and trade count are both free for a group trading with itself; the count
# of distinct buyers is the part that costs real money to fake. A coin is never green until this
# number has actually been measured (GeckoTerminal reports it; DexScreener does not).
# MIN_BUYERS_H1=10
# MAX_TRADES_PER_BUYER=12
# Selling WALLETS against buying wallets. A coin can show a healthy buy/sell split while the
# wallets holding it leave one after another: 1.25 means a coin is refused once half again as many
# wallets are getting out as are getting in. That is the hour an insider position is handed to
# whoever the chart attracted, and the one thing those coins cannot hide.
# MAX_SELLER_BUYER_RATIO=1.25
# MIN_MARKET_CAP_USD=20000
# MAX_MARKET_CAP_USD=30000000
# Dev history, learned from launches this bot saw while running. 0 disables a rule.
# MAX_DEV_RUGS=1
# MAX_DEV_LAUNCHES=5
# A coin that falls this fraction from its observed peak counts as a rug against its creator (0.8 = -80%).
# RUG_DROP_PCT=0.8

# Holder-concentration gate. Only active when SOLANA_RPC_URL is set. It may contain a provider key,
# so keep it only in .env. The public mainnet endpoint rate-limits these calls heavily.
# SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=0a6863b7-36ac-40a4-ab15-d42e34283b2a
# MAX_TOP_HOLDERS_PCT=35
# TOP_HOLDERS_COUNT=5
# Fallback only: the biggest account is skipped when its owner cannot be classified. Normally the
# bot asks the chain what each owner IS — a wallet (System Program) or a pool vault (a DEX
# program) — so a whale holding 99% is counted rather than mistaken for the pool.
# TOP_HOLDERS_SKIP_LARGEST=true

# The creator must no longer be able to mint more supply, or freeze your tokens so you cannot sell.
# REQUIRE_MINT_REVOKED=true
# REQUIRE_FREEZE_REVOKED=true

# How much SUPPLY may sit in wallets with no history. Counting fresh HOLDERS instead rejected
# nearly every live coin when tested, because a young coin is held by young wallets; what is
# dangerous is a large share of supply behind addresses that appeared minutes ago. A wallet counts
# as fresh if it has almost no history, or if its entire history is recent.
# MAX_FRESH_SUPPLY_PCT=25
# FRESH_WALLET_MAX_TX=8
# FRESH_WALLET_MAX_AGE_HOURS=24
# FRESH_WALLET_SIGNATURE_LIMIT=50

# Holders funded by the SAME wallet are one actor across several addresses — the cluster you see
# joined by lines on a bubble map. Their combined holding is what can be dumped at once, so it is
# judged as a single holder, and the limit belongs near the single-holder limit above.
# MAX_CLUSTER_PCT=15
# All clusters together, each wallet counted once: a map with several hubs is one actor using
# several funders, and judging only the biggest group lets it through by splitting twice.
# MAX_LINKED_SUPPLY_PCT=25
# How many holders one wallet may have funded before the coin is refused on the COUNT alone,
# whatever each of them holds, and how close together that funding has to be to mean anything.
# Wallets funded months apart share an address because it is an exchange hot wallet, not because
# somebody set them up for this launch.
# MAX_CLUSTER_WALLETS=3
# CLUSTER_BURST_HOURS=72
# How many holders the funding graph is walked over (the RPC returns at most 20). Each one costs up
# to two extra calls, and a cluster of twenty wallets at 1.5% each is invisible to a top-5 check.
# CLUSTER_HOLDER_COUNT=20

# ---- Bot 3: which entries it may take ----
# dip      = only buy a pullback that bounces. Best fill, but a coin that climbs steadily never
#            dips, so the whole move goes past.
# breakout = only buy new highs. Catches the climbers, pays a worse price.
# both     = whichever comes first (default). Every entry records which trigger fired, and
#            npm run report shows which one is actually making the money.
# ENTRY_MODE=both

# ---- Agent 4: how closely it watches what it might buy ----
# WATCH_POLL_INTERVAL_MS=3000
# MAX_WATCHLIST=40
# A candidate that never triggers an entry goes back and has to earn its place again after this long.
# WATCH_GRACE_MS=600000
