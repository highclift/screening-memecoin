# Optional. The free mode (default) works without a key. NEVER commit a real key.
# PUMPPORTAL_API_KEY=replace_me

# free = PumpPortal launches/migrations + DexScreener/GeckoTerminal prices (no SOL needed)
# pumpportal = paid PumpPortal trade stream (needs wallet with >= 0.02 SOL)
# TRADE_SOURCE=free
# POLL_INTERVAL_MS=3000

# SOCIAL_MODE: twitter = X/Twitter required (default) | any = at least one link | multiple = at least two link types | off = no social filter
# SOCIAL_MODE=twitter

# Market-cap screening bounds are in USD.
# MIN_MARKET_CAP_USD=40000
# MAX_MARKET_CAP_USD=160000

# Optional local dashboard port. Default: 3000.
# WEB_PORT=3000

# ---- Filter + analyst pipeline (see PIPELINE.md). All optional; these are starting points to tune. ----
# Analyst score (0-1) a candidate needs before a paper entry.
# MIN_SCORE=0.5
# Reject pools with less liquidity than this (only when the data source reports liquidity).
# MIN_LIQUIDITY_USD=5000
# Dev history, learned from launches this bot saw while running. 0 disables a rule.
# MAX_DEV_RUGS=1
# MAX_DEV_LAUNCHES=5
# A token that falls this fraction from its observed peak while screened counts as a rug (0.8 = -80%).
# RUG_DROP_PCT=0.8

# Holder-concentration check. Only active when SOLANA_RPC_URL is set. It may contain a provider
# key, so keep it only in .env. The public mainnet endpoint rate-limits these calls heavily.
# SOLANA_RPC_URL=
# MAX_TOP_HOLDERS_PCT=35
# TOP_HOLDERS_COUNT=5
# Skip the single largest account when summing (usually the AMM pool vault). Heuristic.
# TOP_HOLDERS_SKIP_LARGEST=true

# Token metadata is only fetched from these hosts (comma-separated; replaces the default list of
# common IPFS/Arweave gateways). Anything else is skipped so a token creator cannot make this
# machine request arbitrary URLs.
# METADATA_HOSTS=ipfs.io,cf-ipfs.com,gateway.pinata.cloud

# ---- Lanes (independent paper bots; see PIPELINE.md) ----
# fresh   = tokens that just migrated to an AMM pool (uses the dashboard settings above)
# young   = pools 1 hour .. 24 hours old   |  veteran = pools 1 day .. 30 days old
# young/veteran need TRADE_SOURCE=free. Each lane has its own paper balance and thresholds.
# LANES=fresh,young,veteran

# Discovery of already-trading tokens uses GeckoTerminal's free API (limit: 30 calls/minute, shared with
# the unique-buyer checks). These keep the bot under that limit.
# DISCOVERY_TICK_MS=15000
# GECKO_REFRESH_MS=20000
# GECKO_CALLS_PER_MINUTE=24

# Any lane setting can be overridden with <LANE>_<NAME>. Percentages are fractions (0.15 = 15%).
# Defaults shown are starting guesses, not validated: tune them from the journal (npm run report).
# YOUNG_MIN_MARKET_CAP_USD=60000        YOUNG_MAX_MARKET_CAP_USD=1500000
# YOUNG_MIN_LIQUIDITY_USD=15000         YOUNG_MIN_VOLUME_H1_USD=20000
# YOUNG_MIN_TRADES=150                  YOUNG_MIN_BUYS=70               YOUNG_MIN_UNIQUE_BUYERS=40   (last hour)
# YOUNG_PULLBACK_PCT=0.15               YOUNG_BOUNCE_PCT=0.04
# YOUNG_TAKE_PROFIT_PCT=0.15            YOUNG_STOP_LOSS_PCT=0.12        YOUNG_MAX_HOLD_SECONDS=900
# YOUNG_MAX_CANDIDATE_AGE_SECONDS=900  YOUNG_MIN_SCORE=0.5
# YOUNG_MAX_ENTRIES_PER_DAY=15          YOUNG_MAX_OPEN_POSITIONS=3      YOUNG_MAX_ACTIVE_CANDIDATES=150
# YOUNG_BUY_AMOUNT_SOL=0.01             YOUNG_PAPER_START_BALANCE_SOL=1
# YOUNG_SOCIAL_MODE=any
# VETERAN_MIN_MARKET_CAP_USD=250000     VETERAN_MAX_MARKET_CAP_USD=10000000
# VETERAN_MIN_LIQUIDITY_USD=50000       VETERAN_MIN_VOLUME_H1_USD=40000
# VETERAN_MIN_TRADES=200                VETERAN_MIN_BUYS=90             VETERAN_MIN_UNIQUE_BUYERS=50
# VETERAN_PULLBACK_PCT=0.10             VETERAN_BOUNCE_PCT=0.03
# VETERAN_TAKE_PROFIT_PCT=0.12          VETERAN_STOP_LOSS_PCT=0.10      VETERAN_MAX_HOLD_SECONDS=1800
